<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.zqnt</groupId>
    <artifactId>zqnt-sdk-java</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Zequent Java SDKs</name>
    <description>Edge SDK (adapters to the platform) and Client SDK (applications to the platform) for Java.</description>
    <url>https://github.com/zequent/zqnt-sdk-java</url>

    <modules>
        <module>edge</module>
        <module>client</module>
    </modules>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Zequent Development Team</name>
            <email>dev@zequent.com</email>
            <organization>Zequent</organization>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/zequent/zqnt-sdk-java.git</connection>
        <developerConnection>scm:git:https://github.com/zequent/zqnt-sdk-java.git</developerConnection>
        <url>https://github.com/zequent/zqnt-sdk-java</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <compiler-plugin.version>3.16.0</compiler-plugin.version>
        <surefire-plugin.version>3.6.1</surefire-plugin.version>
        <jandex-plugin.version>3.6.0</jandex-plugin.version>
        <grpc.version>1.85.1</grpc.version>
        <protobuf.version>3.25.9</protobuf.version>
        <slf4j.version>2.0.20</slf4j.version>
        <lombok.version>1.18.48</lombok.version>
        <junit.version>6.1.3</junit.version>
        <proguard.version>7.10.0</proguard.version>
        <zqnt-api.version>3.0.0-PR2-c3bcf24-SNAPSHOT</zqnt-api.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.zqnt</groupId>
                <artifactId>zqnt-api</artifactId>
                <version>${zqnt-api.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>zqnt-api-repo</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Zequent/zqnt-api</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>com.github.wvengen</groupId>
                    <artifactId>proguard-maven-plugin</artifactId>
                    <version>2.7.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.guardsquare</groupId>
                            <artifactId>proguard-base</artifactId>
                            <version>${proguard.version}</version>
                            <scope>runtime</scope>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>obfuscate-main-artifact</id>
                            <phase>package</phase>
                            <goals>
                                <goal>proguard</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <injar>${project.build.finalName}.jar</injar>
                        <!-- attach=false and no outjar makes ProGuard replace the main JAR. -->
                        <attach>false</attach>
                        <attachMap>false</attachMap>
                        <attachSeed>false</attachSeed>
                        <proguardVersion>${proguard.version}</proguardVersion>
                        <libs>
                            <lib>${java.home}/jmods/java.base.jmod</lib>
                        </libs>
                        <proguardInclude>${project.basedir}/proguard-rules.pro</proguardInclude>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            Customer-facing build. ProGuard (declared in each module's release profile) overwrites
            the module's regular JAR, so deploy/install publishes the protected artifact without a
            classifier.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>require-release-jdk</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireJavaVersion>
                                            <version>[21,22)</version>
                                            <message>The release profile must run with JDK 21.</message>
                                        </requireJavaVersion>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <distributionManagement>
        <repository>
            <id>zqnt-sdk-repo</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Zequent/zqnt-sdk-java</url>
        </repository>
        <snapshotRepository>
            <id>zqnt-sdk-repo</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Zequent/zqnt-sdk-java</url>
        </snapshotRepository>
    </distributionManagement>

</project>
